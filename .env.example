# Live web dictation: host-only credential; never forwarded to agent containers.
ELEVENLABS_API_KEY=
# elevenlabs (default) or disabled. Each group can override this in Agent Settings.
DEFAULT_VOICE_INPUT_BACKEND=elevenlabs

# Per-container limits for agents and MCP probes. "0" disables each cap.
# A memory cap also disables container swap.
CONTAINER_MEMORY_LIMIT=1536m
CONTAINER_CPU_LIMIT=2

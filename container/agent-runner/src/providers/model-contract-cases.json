  "limits": {
    "_": "How a catalog's raw (context, output) pair becomes recorded limits. An output cap at or above the whole context window is the absence of a cap — 47 of the Vercel gateway's 226 models and 1309 of models.dev's 6652 report it that way, and storing it renders a budget bar that can never move.",
    "cases": [
      { "why": "a real cap below the window", "context": 1000000, "output": 128000, "context_window": 1000000, "max_output_tokens": 128000 },
      { "why": "cap equal to the window is no cap", "context": 1000000, "output": 1000000, "context_window": 1000000 },
      { "why": "cap above the window is no cap", "context": 256000, "output": 512000, "context_window": 256000 },
      { "why": "window only", "context": 200000, "output": 0, "context_window": 200000 },
      { "why": "cap only", "context": 0, "output": 8192, "max_output_tokens": 8192 },
      { "why": "nothing stated", "context": 0, "output": 0 }
    ]
  },

  "endpoints": {
    "_": "Host picker/credential mapping and the native runner resolve the same endpoint. Defaults apply only to reviewed upstream/package pairs with no model or provider API URL.",
    "cases": [
      { "why": "Groq SDK default when models.dev omits the API URL", "upstream": "groq", "provider": { "npm": "@ai-sdk/groq" }, "model": {}, "api": "https://api.groq.com/openai/v1", "npm": "@ai-sdk/groq", "compatible": true },
      { "why": "provider API takes precedence over the SDK default", "upstream": "groq", "provider": { "npm": "@ai-sdk/groq", "api": "https://provider.test/v1" }, "model": {}, "api": "https://provider.test/v1", "npm": "@ai-sdk/groq", "compatible": true },
      { "why": "model API and package take precedence over provider metadata", "upstream": "groq", "provider": { "npm": "@ai-sdk/groq", "api": "https://provider.test/v1" }, "model": { "provider": { "npm": "@ai-sdk/anthropic", "api": "https://model.test/anthropic/v1" } }, "api": "https://model.test/anthropic/v1", "npm": "@ai-sdk/anthropic", "compatible": true },
      { "why": "another upstream using the Groq SDK does not inherit Groq's endpoint", "upstream": "unknown", "provider": { "npm": "@ai-sdk/groq" }, "model": {}, "api": null, "npm": "@ai-sdk/groq", "compatible": false },
      { "why": "a Groq model with another package does not inherit the SDK default", "upstream": "groq", "provider": { "npm": "@ai-sdk/groq" }, "model": { "provider": { "npm": "@ai-sdk/openai-compatible" } }, "api": null, "npm": "@ai-sdk/openai-compatible", "compatible": false },
      { "why": "unsupported packages remain excluded", "upstream": "groq", "provider": { "npm": "@ai-sdk/google", "api": "https://provider.test/v1" }, "model": {}, "api": "https://provider.test/v1", "npm": "@ai-sdk/google", "compatible": false },
      { "why": "unknown providers without endpoints remain excluded", "upstream": "unknown", "provider": {}, "model": {}, "api": null, "npm": "@ai-sdk/openai-compatible", "compatible": false },
      { "why": "empty provider URLs do not fall back to the SDK default", "upstream": "groq", "provider": { "npm": "@ai-sdk/groq", "api": "" }, "model": {}, "api": "", "npm": "@ai-sdk/groq", "compatible": false },
      { "why": "empty model URLs do not fall back to the provider URL", "upstream": "groq", "provider": { "npm": "@ai-sdk/groq", "api": "https://provider.test/v1" }, "model": { "provider": { "api": "" } }, "api": "", "npm": "@ai-sdk/groq", "compatible": false },
      { "why": "unresolved templates do not fall back to the SDK default", "upstream": "groq", "provider": { "npm": "@ai-sdk/groq", "api": "https://${REGION}.test/v1" }, "model": {}, "api": "https://${REGION}.test/v1", "npm": "@ai-sdk/groq", "compatible": false },
      { "why": "malformed URLs do not fall back to the SDK default", "upstream": "groq", "provider": { "npm": "@ai-sdk/groq", "api": "not-a-url" }, "model": {}, "api": "not-a-url", "npm": "@ai-sdk/groq", "compatible": false },
      { "why": "non-HTTP endpoints remain excluded", "upstream": "groq", "provider": { "npm": "@ai-sdk/groq", "api": "ftp://provider.test/v1" }, "model": {}, "api": "ftp://provider.test/v1", "npm": "@ai-sdk/groq", "compatible": false },
      { "why": "URLs with embedded credentials remain excluded", "upstream": "groq", "provider": { "npm": "@ai-sdk/groq", "api": "https://user:password@provider.test/v1" }, "model": {}, "api": "https://user:password@provider.test/v1", "npm": "@ai-sdk/groq", "compatible": false },
      { "why": "URLs with query parameters remain excluded", "upstream": "groq", "provider": { "npm": "@ai-sdk/groq", "api": "https://provider.test/v1?key=example" }, "model": {}, "api": "https://provider.test/v1?key=example", "npm": "@ai-sdk/groq", "compatible": false },
      { "why": "URLs with fragments remain excluded", "upstream": "groq", "provider": { "npm": "@ai-sdk/groq", "api": "https://provider.test/v1#fragment" }, "model": {}, "api": "https://provider.test/v1#fragment", "npm": "@ai-sdk/groq", "compatible": false }
    ]
  },

  "wire": {
    "_": "container_configs.model under the opencode provider is always stored fully qualified as <upstream>/<model-id>, with upstream_provider naming that same upstream. The host joins (src/model-wire.ts), the container peels the prefix back off (providers/opencode.ts).",
    "cases": [
      { "why": "plain id under a direct upstream", "upstream": "minimax", "modelId": "MiniMax-M3", "stored": "minimax/MiniMax-M3" },
      { "why": "id that itself contains a slash", "upstream": "openrouter", "modelId": "minimax/minimax-m3", "stored": "openrouter/minimax/minimax-m3" },
      { "why": "id starting with its own upstream's name", "upstream": "openrouter", "modelId": "openrouter/auto", "stored": "openrouter/openrouter/auto" },
      { "why": "no upstream configured", "upstream": "", "modelId": "minimax/minimax-m3", "stored": "minimax/minimax-m3" }
    ]
  }
}
